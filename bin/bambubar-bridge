#!/usr/bin/env python3
"""Bridge between the Omarchy shell and a Bambu Lab printer on the local network.

QML has no TLS socket, so the shell talks to the printer through this process.
It speaks NDJSON (one JSON object per line) in both directions: the shell
writes commands to our stdin and reads events from our stdout.

Bambu Lab printers run an MQTT broker on port 8883 (TLS with a self-signed
certificate, user "bblp", password = the access code). We subscribe to
device/<serial>/report, ask for a full status dump ("pushall") and merge the
partial updates that follow. The MQTT client below is just enough of MQTT
3.1.1 for that (QoS 0), so there are no dependencies beyond the standard
library.

Commands (stdin)
    {"op":"configure","host":"192.168.1.50","serial":"01P00A...","accessCode":"12345678"}
        Save host and serial to ~/.config/bambubar/printer.json, the access
        code to the system keyring (secret-tool), and reconnect. An empty
        accessCode keeps the stored one. The code arrives here rather than in
        argv because /proc/<pid>/cmdline is readable by other processes.
    {"op":"trust"}         forget the pinned certificate and pin the one the
                           printer presents now (it must still name the serial)
    {"op":"refresh"}       ask the printer for a full status dump again

Events (stdout)
    {"ev":"config","host":"...","serial":"...","hasCode":true,"fingerprint":"sha256 hex","demo":false}
    {"ev":"status","status":"notConfigured|connecting|connected|denied|disconnected|failed|untrusted|wrongPrinter","detail":"..."}
    {"ev":"state", ...printer fields..., "totalPrintSeconds":123}
    {"ev":"saved","ok":true,"warning":"keyring"}   or   {"ev":"saved","ok":false,"error":"invalid-host"}

Flags
    --demo      sample data, no printer or network needed (screenshots, UI work)

Certificate pinning. The access code is the printer's only credential, and an
IP address from DHCP says nothing about who answers there. The printer's
certificate is self-signed by Bambu and names the printer's serial number, so
the first connection only goes ahead when that name matches the configured
serial; its SHA-256 fingerprint is then saved, and every later connection must
present the same certificate before the access code is sent ("untrusted"
otherwise). A different serial in the certificate means another device is
answering at that address ("wrongPrinter").
"""

import hashlib
import json
import math
import os
import queue
import re
import signal
import socket
import ssl
import subprocess
import sys
import threading
import time
import uuid

sys.dont_write_bytecode = True

PORT = 8883
CONNECT_TIMEOUT = 8
RECONNECT_SEC = 5
# A device that isn't the pinned printer won't change its mind quickly.
RECHECK_UNTRUSTED_SEC = 30
PING_SEC = 30
# The printer reports at least every few seconds and answers pings, so a
# connection that has been silent this long is dead.
SILENCE_SEC = 75
SAVE_TOTAL_SEC = 60
MAX_PACKET = 2 * 1024 * 1024

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "bambubar")
CONFIG_FILE = os.path.join(CONFIG_DIR, "printer.json")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bambubar")
STATS_FILE = os.path.join(STATE_DIR, "stats.json")

HOST_RE = re.compile(r"^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.?)+$|^[0-9A-Fa-f:]{2,39}$")
SERIAL_RE = re.compile(r"^[A-Za-z0-9]{1,32}$")
CODE_RE = re.compile(r"^[\x21-\x7e]{1,64}$")
STATE_RE = re.compile(r"^[A-Z_]{0,24}$")
FINGERPRINT_RE = re.compile(r"^[0-9a-f]{64}$")
COLOR_RE = re.compile(r"^[0-9A-Fa-f]{8}$")


# ---------------------------------------------------------------------------
# MQTT 3.1.1, QoS 0 only

class ProtocolError(Exception):
    pass


def mqtt_string(s):
    b = s.encode("utf-8")
    return len(b).to_bytes(2, "big") + b


def mqtt_packet(header, body):
    out = bytearray([header])
    n = len(body)
    while True:
        b = n % 128
        n //= 128
        if n:
            b |= 0x80
        out.append(b)
        if not n:
            break
    return bytes(out) + body


def connect_packet(client_id, user, password, keepalive=60):
    # Protocol level 4, flags: username + password + clean session.
    flags = bytes([0x04, 0xC2]) + keepalive.to_bytes(2, "big")
    return mqtt_packet(0x10, mqtt_string("MQTT") + flags + mqtt_string(client_id)
                       + mqtt_string(user) + mqtt_string(password))


def subscribe_packet(topic, packet_id=1):
    return mqtt_packet(0x82, packet_id.to_bytes(2, "big") + mqtt_string(topic) + b"\x00")


def publish_packet(topic, payload):
    return mqtt_packet(0x30, mqtt_string(topic) + payload)


PINGREQ = b"\xc0\x00"


def take_packets(buf):
    """Remove every complete packet from buf (a bytearray) and return them as (first byte, body)."""
    out = []
    while len(buf) >= 2:
        mult, rem, idx, complete = 1, 0, 1, False
        while idx < len(buf) and idx <= 4:
            b = buf[idx]
            idx += 1
            rem += (b & 0x7F) * mult
            mult *= 128
            if not b & 0x80:
                complete = True
                break
        if not complete:
            if idx > 4:
                raise ProtocolError("malformed remaining length")
            break
        if rem > MAX_PACKET:
            raise ProtocolError("packet too large")
        if len(buf) < idx + rem:
            break
        out.append((buf[0], bytes(buf[idx:idx + rem])))
        del buf[:idx + rem]
    return out


def parse_publish(first, body):
    """Topic and payload of a PUBLISH packet, or None when it is malformed."""
    if len(body) < 2:
        return None
    tl = int.from_bytes(body[0:2], "big")
    if len(body) < 2 + tl:
        return None
    topic = body[2:2 + tl].decode("utf-8", "replace")
    qos = (first >> 1) & 3
    off = 2 + tl + (2 if qos else 0)
    if len(body) < off:
        return None
    return topic, body[off:]


# ---------------------------------------------------------------------------
# Certificates. Python's ssl module only describes a peer certificate it has
# verified, and the printer's can't be verified, so the subject is read from
# the DER bytes directly: just enough ASN.1 to walk to the subject's CN.

def _der_items(data, start, end):
    """Yield (tag, value start, value end) for each TLV between start and end."""
    i = start
    while i < end:
        if i + 2 > end:
            raise ValueError("truncated header")
        tag, length = data[i], data[i + 1]
        i += 2
        if length & 0x80:
            n = length & 0x7F
            if n == 0 or n > 4 or i + n > end:
                raise ValueError("bad length")
            length = int.from_bytes(data[i:i + n], "big")
            i += n
        if i + length > end:
            raise ValueError("truncated value")
        yield tag, i, i + length
        i += length


def _first(data, start, end):
    for item in _der_items(data, start, end):
        return item
    raise ValueError("empty")


def cert_common_name(der):
    """The subject CN of a DER certificate, or "" when there isn't one."""
    try:
        _, cs, ce = _first(der, 0, len(der))      # Certificate
        _, ts, te = _first(der, cs, ce)           # TBSCertificate
        fields = list(_der_items(der, ts, te))
        if fields and fields[0][0] == 0xA0:       # explicit version
            fields = fields[1:]
        # serialNumber, signature, issuer, validity, subject
        _, ss, se = fields[4]
        for _, rs, re_ in _der_items(der, ss, se):            # RDN (SET)
            for _, as_, ae in _der_items(der, rs, re_):       # AttributeTypeAndValue
                parts = list(_der_items(der, as_, ae))
                if len(parts) == 2 and parts[0][0] == 0x06 and der[parts[0][1]:parts[0][2]] == b"\x55\x04\x03":
                    return der[parts[1][1]:parts[1][2]].decode("utf-8", "replace")
    except (ValueError, IndexError):
        pass
    return ""


# ---------------------------------------------------------------------------
# Printer state. Every value comes from the network, so it is type-checked and
# bounded before it reaches the shell.

def _number(v, lo, hi):
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
        return None
    return max(lo, min(hi, v))


def _int_text(v, lo, hi):
    """AMS fields arrive as strings ("4"), sometimes as numbers."""
    if isinstance(v, str) and re.fullmatch(r"-?\d{1,6}", v.strip()):
        v = int(v.strip())
    n = _number(v, lo, hi)
    return None if n is None else int(n)


def _text(v, limit=120):
    if not isinstance(v, str):
        return None
    v = re.sub(r"[\x00-\x1f\x7f]", " ", v).strip()
    return v[:limit]


def _color(v):
    """Bambu colours are RRGGBBAA hex; "00000000" means unknown."""
    if not isinstance(v, str) or not COLOR_RE.match(v) or v == "00000000":
        return None
    return "#" + v[:6].upper()


def _id(v, digits=3):
    if isinstance(v, int) and not isinstance(v, bool):
        v = str(v)
    if isinstance(v, str) and re.fullmatch(r"\d{1,%d}" % digits, v):
        return str(int(v))
    return None


def new_tray(tid):
    return {"id": tid, "type": "", "name": "", "colors": [], "empty": True}


def apply_tray(tray, t):
    """Merge one tray (an AMS slot or an external spool) into tray."""
    if not (set(t) - {"id"}):
        # The printer describes an empty slot by its id alone.
        tray.update(type="", name="", colors=[], empty=True)
        return tray
    kind = _text(t.get("tray_type"), 16)
    if kind is not None:
        tray["type"] = kind
    name = _text(t.get("tray_sub_brands"), 24)
    if name is not None:
        tray["name"] = name
    cols = t.get("cols")
    colors = [c for c in (_color(x) for x in cols[:4]) if c] if isinstance(cols, list) else []
    if colors:
        tray["colors"] = colors
    elif "tray_color" in t:
        c = _color(t.get("tray_color"))
        tray["colors"] = [c] if c else []
    tray["empty"] = not tray["type"] and not tray["colors"]
    return tray


def new_printer_state():
    return {
        "gcodeState": "", "percent": 0, "remainingMin": 0,
        "nozzle": 0.0, "nozzleTarget": 0.0, "bed": 0.0, "bedTarget": 0.0,
        "job": "", "layer": 0, "totalLayers": 0, "ams": [],
        # Dual-nozzle printers (H2D, X2D): one entry per nozzle, id 0 = right,
        # 1 = left, and which one is printing.
        "nozzles": [], "activeNozzle": -1,
        # External spools: vt_tray on single-nozzle printers, vir_slot on
        # dual-nozzle ones.
        "external": [],
        "trayNow": None,
    }


def apply_report(state, p):
    """Merge one "print" report into state. The printer sends partial updates,
    so only keys that are present are overwritten."""
    v = p.get("gcode_state")
    if isinstance(v, str) and STATE_RE.match(v):
        state["gcodeState"] = v
    for key, field, lo, hi in (
        ("mc_percent", "percent", 0, 100),
        ("mc_remaining_time", "remainingMin", 0, 100000),
        ("layer_num", "layer", 0, 1000000),
        ("total_layer_num", "totalLayers", 0, 1000000),
    ):
        n = _number(p.get(key), lo, hi)
        if n is not None:
            state[field] = int(n)
    for key, field in (
        ("nozzle_temper", "nozzle"), ("nozzle_target_temper", "nozzleTarget"),
        ("bed_temper", "bed"), ("bed_target_temper", "bedTarget"),
    ):
        n = _number(p.get(key), -100, 1000)
        if n is not None:
            state[field] = round(float(n), 1)
    job = _text(p.get("subtask_name"))
    if job is not None:
        state["job"] = job

    ams = p.get("ams")
    if isinstance(ams, dict):
        now = _int_text(ams.get("tray_now"), 0, 255)
        if now is not None:
            state["trayNow"] = now
    units = ams.get("ams") if isinstance(ams, dict) else None
    if isinstance(units, list):
        known = {u["id"]: u for u in state["ams"]}
        for u in units[:16]:
            if not isinstance(u, dict):
                continue
            uid = _id(u.get("id"))
            if uid is None:
                continue
            unit = known.get(uid) or {"id": uid, "level": 0, "percent": None, "trays": []}
            level = _int_text(u.get("humidity"), 0, 5)
            if level is not None:
                unit["level"] = level
            raw = _int_text(u.get("humidity_raw"), 0, 100)
            if raw is not None:
                unit["percent"] = raw
            trays = u.get("tray")
            if isinstance(trays, list):
                slots = {t["id"]: t for t in unit["trays"]}
                for t in trays[:4]:
                    tid = _id(t.get("id"), 2) if isinstance(t, dict) else None
                    if tid is not None:
                        slots[tid] = apply_tray(slots.get(tid) or new_tray(tid), t)
                unit["trays"] = sorted(slots.values(), key=lambda t: int(t["id"]))
            known[uid] = unit
        state["ams"] = sorted(known.values(), key=lambda u: int(u["id"]))[:16]

    externals = p.get("vir_slot")
    if isinstance(p.get("vt_tray"), dict) and not isinstance(externals, list):
        externals = [p["vt_tray"]]
    if isinstance(externals, list):
        slots = {t["id"]: t for t in state["external"]}
        for t in externals[:2]:
            tid = _id(t.get("id")) if isinstance(t, dict) else None
            if tid is not None:
                slots[tid] = apply_tray(slots.get(tid) or new_tray(tid), t)
        state["external"] = sorted(slots.values(), key=lambda t: int(t["id"]))

    device = p.get("device")
    extruder = device.get("extruder") if isinstance(device, dict) else None
    if isinstance(extruder, dict):
        st = _number(extruder.get("state"), 0, 0xFFFFFFFF)
        if st is not None and (int(st) >> 4) & 0xF in (0, 1):  # 15 while switching
            state["activeNozzle"] = (int(st) >> 4) & 0xF
        info = extruder.get("info")
        if isinstance(info, list):
            nozzles = {n["id"]: n for n in state["nozzles"]}
            for entry in info[:2]:
                nid = entry.get("id") if isinstance(entry, dict) else None
                if nid not in (0, 1) or isinstance(nid, bool):
                    continue
                n = nozzles.get(nid) or {"id": nid, "temp": 0, "target": 0, "source": None}
                packed = _number(entry.get("temp"), 0, 0xFFFFFFFF)
                if packed is not None:
                    # Low word is the current temperature, high word the target.
                    n["temp"] = min(int(packed) & 0xFFFF, 1000)
                    n["target"] = min((int(packed) >> 16) & 0xFFFF, 1000)
                source = _number(entry.get("snow"), 0, 0xFFFF)
                if source is not None:
                    n["source"] = int(source)
                nozzles[nid] = n
            state["nozzles"] = sorted(nozzles.values(), key=lambda n: n["id"])
    return state


def active_spool(state):
    """Which spool feeds the nozzle that is printing: {"ams": id, "tray": id},
    {"external": id} or None."""
    source = None
    for n in state["nozzles"]:
        if n["id"] == state["activeNozzle"]:
            source = n["source"]
    if source is not None:
        # unit << 8 | tray; 0xFFFF is nothing loaded, units 254/255 the
        # external spools.
        if source == 0xFFFF:
            return None
        unit, tray = source >> 8, source & 0xFF
    else:
        now = state["trayNow"]
        if now is None or now == 255:
            return None
        if now == 254:
            return {"external": "254"}
        unit, tray = (now, 0) if now >= 128 else (now >> 2, now & 3)
    if unit in (254, 255):
        return {"external": str(unit)}
    return {"ams": str(unit), "tray": str(tray)}


# ---------------------------------------------------------------------------
# Storage

def _write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def _read_json(path):
    try:
        with open(path) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def load_config():
    data = _read_json(CONFIG_FILE)
    host = data.get("host") if isinstance(data.get("host"), str) else ""
    serial = data.get("serial") if isinstance(data.get("serial"), str) else ""
    fingerprint = data.get("fingerprint") if isinstance(data.get("fingerprint"), str) else ""
    if not HOST_RE.match(host or "-") or len(host) > 253:
        host = ""
    if not SERIAL_RE.match(serial or "-"):
        serial = ""
    if not FINGERPRINT_RE.match(fingerprint):
        fingerprint = ""
    return host, serial, fingerprint


def save_config(host, serial, fingerprint):
    _write_json(CONFIG_FILE, {"host": host, "serial": serial, "fingerprint": fingerprint})


def load_total():
    n = _number(_read_json(STATS_FILE).get("totalPrintSeconds"), 0, 1e10)
    return float(n or 0)


def keyring_lookup(serial):
    try:
        r = subprocess.run(["secret-tool", "lookup", "service", "bambubar", "serial", serial],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def keyring_store(serial, code):
    try:
        r = subprocess.run(["secret-tool", "store", "--label=BambuBar access code (%s)" % serial,
                            "service", "bambubar", "serial", serial],
                           input=code, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


# ---------------------------------------------------------------------------

def emit(event):
    try:
        sys.stdout.write(json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        # The shell went away; nothing left to report to.
        os._exit(0)


def read_commands(commands, stop):
    """Runs on its own thread: stdin lines become commands, EOF ends the bridge."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            cmd = json.loads(line)
        except ValueError:
            continue
        if isinstance(cmd, dict):
            commands.put(cmd)
    stop.set()
    commands.put({"op": "wake"})


class Bridge:
    def __init__(self, stop, commands):
        self.stop = stop
        self.commands = commands
        self.host, self.serial, self.fingerprint = load_config()
        self.code = keyring_lookup(self.serial) if self.serial else ""
        self.printer = new_printer_state()
        self.total = load_total()
        self.saved_total = self.total
        self.last_tick = time.monotonic()
        self.last_save = self.last_tick

        self.sock = None
        self.buf = bytearray()
        self.connected = False
        self.wanted = self.configured()
        self.next_connect = 0.0
        self.opened_at = 0.0
        self.last_rx = 0.0
        self.last_ping = 0.0
        self.status = None

    def configured(self):
        return bool(self.host and self.serial and self.code)

    # -- events

    def emit_config(self):
        emit({"ev": "config", "host": self.host, "serial": self.serial,
              "hasCode": bool(self.code), "fingerprint": self.fingerprint, "demo": False})

    def set_status(self, status, detail=""):
        if (status, detail) == self.status:
            return
        self.status = (status, detail)
        emit({"ev": "status", "status": status, "detail": detail[:200]})

    def emit_state(self):
        event = {"ev": "state", "totalPrintSeconds": int(self.total)}
        event.update(self.printer)
        del event["trayNow"]
        event["activeSpool"] = active_spool(self.printer)
        emit(event)

    # -- connection

    def connect(self):
        self.close()
        # Retries after an error keep showing that error, so the panel doesn't
        # flicker between it and "connecting" every few seconds.
        if self.status is None or self.status[0] in ("connected", "disconnected", "notConfigured", "connecting"):
            self.set_status("connecting")
        try:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False
            # The certificate is self-signed by Bambu; check_identity() pins it instead.
            ctx.verify_mode = ssl.CERT_NONE
            raw = socket.create_connection((self.host, PORT), timeout=CONNECT_TIMEOUT)
            try:
                self.sock = ctx.wrap_socket(raw)
            except BaseException:
                raw.close()
                raise
            if not self.check_identity(self.sock.getpeercert(binary_form=True) or b""):
                return
            self.sock.settimeout(0.5)
            client_id = "bambubar-" + uuid.uuid4().hex[:8]
            self.sock.sendall(connect_packet(client_id, "bblp", self.code))
        except (OSError, ssl.SSLError) as e:
            self.drop("failed", describe(e))
            return
        now = time.monotonic()
        self.opened_at = self.last_rx = self.last_ping = now

    def check_identity(self, der):
        """Whether the access code may go to this peer. Pins the certificate the
        first time, when it names the configured serial."""
        fingerprint = hashlib.sha256(der).hexdigest()
        name = re.sub(r"[^\x20-\x7e]", "?", cert_common_name(der))[:64]
        if self.fingerprint:
            if fingerprint == self.fingerprint:
                return True
            self.drop("untrusted", name, RECHECK_UNTRUSTED_SEC)
            return False
        if name.upper() != self.serial:
            self.drop("wrongPrinter", name, RECHECK_UNTRUSTED_SEC)
            return False
        self.fingerprint = fingerprint
        try:
            save_config(self.host, self.serial, self.fingerprint)
        except OSError:
            pass  # still pinned for this session
        self.emit_config()
        return True

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.buf = bytearray()
        self.connected = False

    def drop(self, status, detail="", retry_after=RECONNECT_SEC):
        self.close()
        self.set_status(status, detail)
        if self.wanted:
            self.next_connect = time.monotonic() + retry_after

    def send(self, data):
        try:
            self.sock.sendall(data)
        except (OSError, ssl.SSLError) as e:
            self.drop("disconnected", describe(e))

    def request_full_state(self):
        if self.sock is not None and self.connected:
            req = b'{"pushing":{"sequence_id":"0","command":"pushall"}}'
            self.send(publish_packet("device/%s/request" % self.serial, req))

    def handle_packet(self, first, body):
        kind = first >> 4
        if kind == 2:  # CONNACK
            if len(body) >= 2 and body[1] == 0:
                self.connected = True
                self.set_status("connected")
                self.send(subscribe_packet("device/%s/report" % self.serial))
                self.request_full_state()
            else:
                # Wrong access code (or LAN mode off). Retrying won't help until
                # the settings change.
                self.wanted = False
                self.drop("denied")
        elif kind == 3:  # PUBLISH
            msg = parse_publish(first, body)
            if msg is None:
                return
            try:
                obj = json.loads(msg[1])
            except ValueError:
                return
            report = obj.get("print") if isinstance(obj, dict) else None
            if isinstance(report, dict):
                apply_report(self.printer, report)
                self.emit_state()

    def pump(self):
        try:
            data = self.sock.recv(65536)
        except (socket.timeout, ssl.SSLWantReadError):
            data = None
        except (OSError, ssl.SSLError) as e:
            self.drop("disconnected", describe(e))
            return
        now = time.monotonic()
        if data is not None:
            if not data:
                self.drop("disconnected")
                return
            self.last_rx = now
            self.buf.extend(data)
            try:
                for first, body in take_packets(self.buf):
                    self.handle_packet(first, body)
                    if self.sock is None:
                        return
            except ProtocolError as e:
                self.drop("disconnected", str(e))
                return
        if not self.connected and now - self.opened_at > CONNECT_TIMEOUT * 2:
            self.drop("failed", "no answer from the printer's MQTT broker")
        elif now - self.last_rx > SILENCE_SEC:
            self.drop("disconnected", "connection timed out")
        elif self.connected and now - self.last_ping >= PING_SEC:
            self.last_ping = now
            self.send(PINGREQ)

    # -- commands

    def handle_command(self, cmd):
        op = cmd.get("op")
        if op == "refresh":
            self.request_full_state()
        elif op == "configure":
            self.configure(cmd)
        elif op == "trust":
            self.trust()

    def trust(self):
        """Pin whatever certificate the printer presents next (it must still
        name the configured serial)."""
        if not self.configured():
            return
        self.fingerprint = ""
        try:
            save_config(self.host, self.serial, "")
        except OSError:
            pass
        self.emit_config()
        self.restart_connection()

    def restart_connection(self):
        self.status = None
        self.wanted = True
        self.next_connect = 0.0
        self.close()

    def configure(self, cmd):
        host = str(cmd.get("host") or "").strip()
        serial = str(cmd.get("serial") or "").strip().upper()
        code = str(cmd.get("accessCode") or "").strip()
        if not host or len(host) > 253 or not HOST_RE.match(host):
            emit({"ev": "saved", "ok": False, "error": "invalid-host"})
            return
        if not SERIAL_RE.match(serial):
            emit({"ev": "saved", "ok": False, "error": "invalid-serial"})
            return
        if code and not CODE_RE.match(code):
            emit({"ev": "saved", "ok": False, "error": "invalid-code"})
            return
        warning = ""
        if code:
            if not keyring_store(serial, code):
                warning = "keyring"  # still used for this session
        else:
            code = self.code if serial == self.serial else keyring_lookup(serial)
            if not code:
                emit({"ev": "saved", "ok": False, "error": "code-missing"})
                return
        changed_printer = serial != self.serial
        # The certificate identifies the printer, so a new address keeps the
        # pin (and proves it is the same printer); a new serial starts over.
        fingerprint = "" if changed_printer else self.fingerprint
        try:
            save_config(host, serial, fingerprint)
        except OSError:
            warning = warning or "config"
        self.host, self.serial, self.code, self.fingerprint = host, serial, code, fingerprint
        if changed_printer:
            self.printer = new_printer_state()
            self.emit_state()
        emit({"ev": "saved", "ok": True, "warning": warning})
        self.emit_config()
        self.restart_connection()

    # -- print time

    def tick(self, force_save=False):
        now = time.monotonic()
        if self.connected and self.printer["gcodeState"] == "RUNNING":
            self.total += now - self.last_tick
        self.last_tick = now
        if (force_save or now - self.last_save >= SAVE_TOTAL_SEC) and self.total != self.saved_total:
            self.last_save = now
            try:
                _write_json(STATS_FILE, {"totalPrintSeconds": round(self.total)})
                self.saved_total = self.total
            except OSError:
                pass
            if not force_save:
                self.emit_state()

    def run(self):
        self.emit_config()
        self.emit_state()
        if not self.configured():
            self.set_status("notConfigured")
        while not self.stop.is_set():
            if self.wanted and self.sock is None and time.monotonic() >= self.next_connect:
                self.connect()
            if self.sock is not None:
                self.pump()
                block = False
            else:
                block = True
            try:
                cmd = self.commands.get(timeout=0.5) if block else self.commands.get_nowait()
                while True:
                    self.handle_command(cmd)
                    cmd = self.commands.get_nowait()
            except queue.Empty:
                pass
            self.tick()
        self.tick(force_save=True)
        self.close()


def describe(e):
    if isinstance(e, socket.timeout):
        return "timed out"
    if isinstance(e, ssl.SSLError):
        return "TLS: " + (e.reason or str(e))
    if isinstance(e, OSError) and e.strerror:
        return e.strerror
    return str(e) or e.__class__.__name__


# ---------------------------------------------------------------------------

def run_demo(stop, commands):
    """A print in progress, for screenshots and UI work."""
    emit({"ev": "config", "host": "192.168.1.50", "serial": "01P00A000000000", "hasCode": True,
          "fingerprint": "", "demo": True})
    emit({"ev": "status", "status": "connected", "detail": ""})
    start = time.monotonic()

    def spool(tid, kind, name, *colors):
        return {"id": tid, "type": kind, "name": name, "colors": list(colors), "empty": not kind}

    while not stop.is_set():
        minutes = (time.monotonic() - start) / 60
        percent = min(99, 64 + int(minutes))
        state = {
            "ev": "state", "gcodeState": "RUNNING", "percent": percent,
            "remainingMin": max(1, 83 - int(minutes * 2)),
            "nozzle": 219.6, "nozzleTarget": 220.0, "bed": 60.0, "bedTarget": 60.0,
            "job": "Benchy_0.2mm_PLA", "layer": 142 + int(minutes * 2), "totalLayers": 222,
            "nozzles": [{"id": 0, "temp": 38, "target": 0, "source": None},
                        {"id": 1, "temp": 220, "target": 220, "source": 1}],
            "activeNozzle": 1,
            "ams": [{"id": "0", "level": 4, "percent": 24, "trays": [
                spool("0", "PLA", "PLA Basic", "#F5F5F5"),
                spool("1", "PLA", "PLA Matte", "#00AE42"),
                spool("2", "PLA", "PLA Silk+", "#C0C0C0", "#D4AF37"),
                spool("3", "", ""),
            ]}],
            "external": [spool("254", "TPU", "", "#2B2B2B")],
            "activeSpool": {"ams": "0", "tray": "1"},
            "totalPrintSeconds": 127 * 3600 + 42 * 60 + int(minutes * 60),
        }
        emit(state)
        try:
            cmd = commands.get(timeout=5)
            if cmd.get("op") == "configure":
                emit({"ev": "saved", "ok": False, "error": "demo"})
        except queue.Empty:
            pass


def main():
    stop = threading.Event()
    commands = queue.Queue()

    def on_signal(*_):
        stop.set()
        commands.put({"op": "wake"})

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    threading.Thread(target=read_commands, args=(commands, stop), daemon=True).start()

    if "--demo" in sys.argv[1:]:
        run_demo(stop, commands)
    else:
        Bridge(stop, commands).run()


if __name__ == "__main__":
    main()
